# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://bilim:bilim_dev_password@127.0.0.1:5434/bilim_merkezi"
# Throwaway DB Prisma replays migrations against when diffing/validating them.
SHADOW_DATABASE_URL="postgresql://bilim:bilim_dev_password@127.0.0.1:5434/bilim_merkezi_shadow"

# Auth.js
AUTH_SECRET="generate-with-npx-auth-secret"
AUTH_URL="http://localhost:3000"
# Google OAuth (optional — leave blank to disable Google sign-in)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Stripe (test mode — get keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Uploads: local (default, server disk) | database (Postgres) | s3 (any S3-compatible bucket)
STORAGE_DRIVER="local"
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="bilim-uploads"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# ── Rate limiting: database (default, shared by all servers) | upstash | memory
RATE_LIMIT_STORE="database"
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# ── SMS: console (default, codes in the server log) | http (your gateway) | otp-gateway (sms-otp-panel)
# SMS_PROVIDER="http"
# SMS_GATEWAY_URL=""
# SMS_GATEWAY_TOKEN=""
# otp-gateway: the panel generates, sends and verifies codes. Key from the panel's "API keys" page.
# SMS_PROVIDER="otp-gateway"
# OTP_GATEWAY_URL="http://192.168.1.107:8000"
# OTP_GATEWAY_API_KEY="sk_live_..."
# Optional: pin the sender SIM (+993XXXXXXXX) if the project has several phones.
# OTP_GATEWAY_FROM=""

# ── AI assistant: auto (default) | ollama | openai | anthropic | off
# auto uses a local Ollama model when it is running, then the options below, else local search.
AI_PROVIDER="auto"
OLLAMA_URL="http://127.0.0.1:11434"
AI_MODEL="qwen2.5:7b"
# OpenAI-compatible local server (LM Studio: http://127.0.0.1:1234/v1, llama.cpp: http://127.0.0.1:8080/v1)
# OPENAI_BASE_URL=""
# OPENAI_API_KEY=""
# Claude (optional, paid API)
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-haiku-4-5"
